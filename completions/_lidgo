#compdef lidgo

local state

_arguments -C \
  '(-h --help)'{-h,--help}'[show help]' \
  '--hold[hold until interrupted]' \
  '(-r --refresh)'{-r,--refresh}'[refresh a pure timer]' \
  '1:command:(switch config setup help)' \
  '*::argument:->arguments'

case "$state" in
  arguments)
    case "$words[2]" in
      switch)
        _arguments '(-f --force)'{-f,--force}'[confirm global force toggle]'
        ;;
      config)
        _arguments \
          '--duration[set future timer duration]:duration (for example 90m or 2h):' \
          '--battery[set battery cutoff]:percentage (1-99):'
        ;;
    esac
    ;;
esac
